def get_grade(alama):
   """Hii function inapokea alama na rudisha grade"""
   if alama >= 80:
     return "A"
   if alama >= 65:
      return "B"
   if alama >= 50:
      return "C"
   if alama >= 35:
      return "D"
   elif:
     return "F"

def get_comment(grade)
   """Hii function inatoa maoni kulingana na grade"""
    comments {
    "A": "Excellent! Hongera sana!",
    "B": "Vizuri sana!",
    "C": "Sawa, jitahidi zaidi",
    "D": "Uko njiani, Soma zaidi",
    "F": "Pole jaribu tena"
    }
  return comments.get(grade, "")

